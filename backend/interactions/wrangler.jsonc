{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "zhuqing-interactions",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "interactions.zhuqing.tech", "custom_domain": true }
  ],
  "secrets_store_secrets": [
    {
      "binding": "TURNSTILE_SECRET_KEY",
      "store_id": "c14ae44358b44bc7ac9b4656136d2c18",
      "secret_name": "TURNSTILE_SECRET_KEY"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://zhuqing.tech,https://www.zhuqing.tech",
    "TURNSTILE_HOSTNAMES": "zhuqing.tech,www.zhuqing.tech",
    "ACCESS_TEAM_DOMAIN": "muddy-thunder-5f00.cloudflareaccess.com",
    "ACCESS_AUD": "5f846e8a9329666eacd2309f66b21651e2375f9a9ccdd78fe98bccaaa29547a7",
    "ADMIN_EMAILS": "zq_eugene@qq.com",
    "MAIL_FROM": "contact@mail.zhuqing.tech"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "zhuqing-interactions", "database_id": "e3274cc9-73d1-4b66-b9a1-bdf2eb74b17b", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "11051001", "simple": { "limit": 30, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "11051002", "simple": { "limit": 300, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *", "47 * * * *"] },
  "observability": { "enabled": false }
}
