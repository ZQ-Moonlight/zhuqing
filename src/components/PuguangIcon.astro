---
interface Props { name: "play" | "arrow" | "chevron" | "expand" | "spark" | "close"; }
const {name} = Astro.props;
const paths = {
    play: "m9 5 10 7-10 7Z",
    arrow: "M5 12h14m-6-6 6 6-6 6",
    chevron: "m9 5 7 7-7 7",
    expand: "M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5",
    spark: "m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5Z",
    close: "m6 6 12 12M6 18 18 6",
};
---
<svg viewBox="0 0 24 24" fill={name === "play" ? "currentColor" : "none"} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
