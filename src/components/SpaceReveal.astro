---
import { withBase } from "../lib/paths";
const media = (name: string) => withBase("/media/portfolio/space-previs/" + name);
---
<header class="reel" data-reveal-reel>
    <div class="screen">
        <div class="aperture">
            <picture>
                <source media="(max-width: 700px) and (orientation: portrait) and (prefers-reduced-motion: no-preference)" srcset={media("reveal-portrait-first.webp")} />
                <source media="(prefers-reduced-motion: no-preference)" srcset={media("reveal-first.webp")} />
                <img src={media("black-hole-poster.webp")} alt="" width="1912" height="800" fetchpriority="high" />
            </picture>
            <video muted playsinline preload="none" aria-hidden="true" disablepictureinpicture
                data-desktop={media("reveal.mp4")} data-mobile={media("reveal-small.mp4")} data-portrait={media("reveal-portrait.mp4")}></video>
        </div>
        <h1 class="end-title" data-i18n-cn="星际险境" data-i18n-en="Peril in Space">星际险境</h1>
    </div>
</header>

<script>
    const reel = document.querySelector<HTMLElement>("[data-reveal-reel]");
    if (reel) {
        const screen = reel.querySelector<HTMLElement>(".screen")!;
        const video = reel.querySelector("video")!;
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        let requested = 0;
        let targetFrame = 0;
        let lastFrame = 0;
        let download: AbortController | undefined;
        let mediaUrl: string | undefined;
        const fps = 24;
        const filmEnd = 0.78;
        new IntersectionObserver(([entry]) => {
            reel!.toggleAttribute("data-on-screen", entry.isIntersecting);
        }).observe(reel);
        function updateTitle() {
            const end = Math.round(video.duration * fps) - 1;
            const finished = end > 0 && targetFrame === end && !video.seeking
                && Math.floor(video.currentTime * fps) === end && video.readyState >= 2;
            reel!.toggleAttribute("data-finished", finished);
        }
        function seek() {
            if (!reel?.hasAttribute("data-active") || video.readyState < 2 || video.seeking || lastFrame === targetFrame) return;
            lastFrame = targetFrame;
            video.currentTime = (targetFrame + 0.25) / fps;
        }
        function paint() {
            requested = 0;
            if (!reel?.hasAttribute("data-active")) return;
            const bounds = reel.getBoundingClientRect();
            const distance = bounds.height - screen.offsetHeight;
            const progress = Math.min(1, Math.max(0, -bounds.top / Math.max(1, distance)));
            if (Number.isFinite(video.duration)) {
                targetFrame = Math.round(Math.min(1, progress / filmEnd) * (Math.round(video.duration * fps) - 1));
                seek();
                updateTitle();
            }
        }
        function schedule() {
            if (!requested) requested = requestAnimationFrame(paint);
        }
        function reset() {
            download?.abort();
            reel!.removeAttribute("data-active");
            reel!.removeAttribute("data-finished");
            window.removeEventListener("scroll", schedule);
            window.removeEventListener("resize", schedule);
            if (video.hasAttribute("src")) {
                video.removeAttribute("src");
                video.load();
            }
            if (mediaUrl) URL.revokeObjectURL(mediaUrl);
            mediaUrl = undefined;
            lastFrame = targetFrame = 0;
        }
        async function configure() {
            reset();
            if (motion.matches || !video.canPlayType("video/mp4")) return;
            const compact = matchMedia("(max-width: 700px)").matches;
            const portrait = compact && matchMedia("(orientation: portrait)").matches;
            video.poster = Array.from(reel!.querySelectorAll("picture source")).find(source => matchMedia(source.media).matches)!.srcset;
            video.muted = true;
            reel!.setAttribute("data-active", "");
            video.preload = "auto";
            window.addEventListener("scroll", schedule, { passive: true });
            window.addEventListener("resize", schedule);
            schedule();
            const url = (portrait ? video.dataset.portrait : compact ? video.dataset.mobile : video.dataset.desktop)!;
            const controller = new AbortController();
            download = controller;
            try {
                const response = await fetch(url, { signal: controller.signal });
                if (!response.ok) throw new Error("Opening clip unavailable");
                const blob = await response.blob();
                if (controller.signal.aborted) return;
                mediaUrl = URL.createObjectURL(blob);
                video.src = mediaUrl;
            } catch {
                if (!controller.signal.aborted) reset();
            }
        }
        video.addEventListener("loadeddata", schedule);
        video.addEventListener("canplay", schedule);
        video.addEventListener("seeked", () => {
            seek();
            updateTitle();
        });
        video.addEventListener("error", reset);
        motion.addEventListener("change", configure);
        configure();
    }
</script>

<style>
    .reel { position: relative; z-index: 125; background: #030405; color: #fff; }
    .screen { position: relative; background: #030405; }
    .aperture { height: 100vh; height: 100dvh; position: relative; overflow: hidden; }
    .aperture img, .aperture video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .aperture video { display: none; }
    .end-title {
        margin: 0; padding: 9vh 4vw; text-align: center; color: #f9f6f3;
        font: 500 clamp(2.7rem, 7.5vw, 8rem)/1.12 "Songti SC", SimSun, Georgia, serif;
        letter-spacing: .21em; text-indent: .21em;
    }
    .reel[data-active]::after { content: ""; display: block; height: clamp(1100px, 200svh, 2100px); }
    [data-active] .screen { position: sticky; top: 0; }
    [data-active] .aperture video { display: block; }
    [data-active] .end-title {
        position: absolute; inset: auto 0 0; padding: 1.2em 4vw max(8dvh, env(safe-area-inset-bottom));
        background: linear-gradient(transparent, #03050980);
        opacity: 0; pointer-events: none; text-shadow: 0 .04em .35em #0009;
    }
    [data-active][data-finished] .end-title { opacity: 1; transition: opacity 600ms ease-out; }
    :global(body:has([data-reveal-reel][data-on-screen]) [data-site-header]),
    :global(body:has([data-reveal-reel][data-on-screen]) [data-read-progress]) { visibility: hidden; }
    @media (max-width: 700px) {
        .reel[data-active]::after { height: 145svh; }
    }
</style>
