---
import { withBase } from "../lib/paths";
const media = (name: string) => withBase("/media/portfolio/space-previs/" + name);
---
<header class="reel" data-reveal-reel>
    <div class="screen">
        <div class="projection">
            <div class="aperture">
                <picture>
                    <source media="(prefers-reduced-motion: no-preference)" srcset={media("reveal-first.webp")} />
                    <img src={media("reveal-last.webp")} alt="" width="1912" height="800" fetchpriority="high" />
                </picture>
                <canvas width="956" height="400" aria-hidden="true" data-sheets={media("reveal-scope/")}></canvas>
                <video muted playsinline preload="none" aria-hidden="true" disablepictureinpicture
                    data-desktop={media("reveal.mp4")} data-mobile={media("reveal-small.mp4")}></video>
            </div>
            <div class="end-credit">
                <time datetime="2025-11" data-i18n-cn="2025 年 11 月" data-i18n-en="November 2025">2025 年 11 月</time>
                <h1 data-i18n-cn="星际险境" data-i18n-en="Peril in Space">星际险境</h1>
            </div>
        </div>
    </div>
</header>

<script>
    const reel = document.querySelector<HTMLElement>("[data-reveal-reel]");
    if (reel) {
        const screen = reel.querySelector<HTMLElement>(".screen")!;
        const video = reel.querySelector("video")!;
        const canvas = reel.querySelector("canvas")!;
        const context = canvas.getContext("2d", { alpha: false });
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        const mobile = matchMedia("(max-width: 760px), (max-width: 1100px) and (pointer: coarse)");
        const sheets = new Map<number, HTMLImageElement>();
        const framesPerSheet = 12;
        const sheetCount = 10;
        const lastStill = framesPerSheet * sheetCount - 1;
        let requested = 0;
        let targetFrame = 0;
        let lastFrame = 0;
        let drawnStill = -1;
        let download: AbortController | undefined;
        let mediaUrl: string | undefined;
        const fps = 24;
        const filmEnd = 0.78;
        function loadSheet(index: number) {
            if (index < 0 || index >= sheetCount || sheets.has(index)) return;
            const image = new Image();
            sheets.set(index, image);
            image.onload = schedule;
            image.onerror = () => {
                if (sheets.get(index) === image) reset();
            };
            image.src = canvas.dataset.sheets + "sheet-" + String(index).padStart(2, "0") + ".webp";
        }
        function drawStill(progress: number) {
            const frame = Math.round(progress * lastStill);
            const sheet = Math.floor(frame / framesPerSheet);
            for (const index of [sheet, sheet + 1, sheet - 1]) loadSheet(index);
            for (const index of sheets.keys()) {
                if (Math.abs(index - sheet) > 1) sheets.delete(index);
            }
            const image = sheets.get(sheet);
            if (frame === drawnStill || !image?.complete || !image.naturalWidth) return;
            const cell = frame % framesPerSheet;
            const { width, height } = canvas;
            context!.drawImage(image, cell % 4 * width, Math.floor(cell / 4) * height, width, height, 0, 0, width, height);
            drawnStill = frame;
            canvas.setAttribute("data-ready", "");
        }
        function updateTitle() {
            const end = Math.round(video.duration * fps) - 1;
            const finished = end > 0 && targetFrame === end && !video.seeking
                && Math.floor(video.currentTime * fps) === end && video.readyState >= 2;
            reel!.toggleAttribute("data-finished", finished);
        }
        function seek() {
            if (!reel?.hasAttribute("data-active") || video.readyState < 2 || video.seeking || lastFrame === targetFrame) return;
            lastFrame = targetFrame;
            video.currentTime = (targetFrame + 0.25) / fps;
        }
        function paint() {
            requested = 0;
            if (!reel?.hasAttribute("data-active")) return;
            const bounds = reel.getBoundingClientRect();
            const distance = bounds.height - screen.offsetHeight;
            const progress = Math.min(1, Math.max(0, -bounds.top / Math.max(1, distance)));
            // Blend the lower edge before it meets the gallery, then dissolve the remaining image.
            const edge = Math.min(1, Math.max(0, (progress - 0.86) / 0.14));
            const exit = Math.min(1, Math.max(0, 1 - bounds.bottom / screen.offsetHeight));
            screen.style.setProperty("--edge", String(edge * edge * (3 - 2 * edge)));
            screen.style.setProperty("--exposure", String(1 - exit * exit * (3 - 2 * exit)));
            const clipProgress = Math.min(1, progress / filmEnd);
            if (reel.hasAttribute("data-frames")) {
                drawStill(clipProgress);
                reel.toggleAttribute("data-finished", drawnStill === lastStill && clipProgress === 1);
            } else if (Number.isFinite(video.duration)) {
                targetFrame = Math.round(clipProgress * (Math.round(video.duration * fps) - 1));
                seek();
                updateTitle();
            }
        }
        function schedule() {
            if (!requested) requested = requestAnimationFrame(paint);
        }
        function reset() {
            download?.abort();
            reel!.removeAttribute("data-active");
            reel!.removeAttribute("data-frames");
            reel!.removeAttribute("data-finished");
            canvas.removeAttribute("data-ready");
            sheets.clear();
            drawnStill = -1;
            screen.style.removeProperty("--edge");
            screen.style.removeProperty("--exposure");
            window.removeEventListener("scroll", schedule);
            window.removeEventListener("resize", schedule);
            if (video.hasAttribute("src")) {
                video.removeAttribute("src");
                video.load();
            }
            if (mediaUrl) URL.revokeObjectURL(mediaUrl);
            mediaUrl = undefined;
            lastFrame = targetFrame = 0;
        }
        async function configure() {
            reset();
            if (motion.matches) return;
            const useStillFrames = mobile.matches && !!context;
            if (!useStillFrames && !video.canPlayType("video/mp4")) return;
            reel!.toggleAttribute("data-frames", useStillFrames);
            reel!.setAttribute("data-active", "");
            window.addEventListener("scroll", schedule, { passive: true });
            window.addEventListener("resize", schedule);
            schedule();
            if (useStillFrames) return;
            video.poster = reel!.querySelector("picture source:last-of-type")!.getAttribute("srcset")!;
            video.muted = true;
            video.preload = "auto";
            const url = (mobile.matches ? video.dataset.mobile : video.dataset.desktop)!;
            const controller = new AbortController();
            download = controller;
            try {
                const response = await fetch(url, { signal: controller.signal });
                if (!response.ok) throw new Error("Opening clip unavailable");
                const blob = await response.blob();
                if (controller.signal.aborted) return;
                mediaUrl = URL.createObjectURL(blob);
                video.src = mediaUrl;
            } catch {
                if (!controller.signal.aborted) reset();
            }
        }
        video.addEventListener("loadeddata", schedule);
        video.addEventListener("canplay", schedule);
        video.addEventListener("seeked", () => {
            seek();
            updateTitle();
        });
        video.addEventListener("error", reset);
        motion.addEventListener("change", configure);
        mobile.addEventListener("change", configure);
        configure();
    }
</script>

<style>
    .reel { position: relative; background: var(--film-black); color: #fff; }
    .screen {
        --screen-height: 100vh;
        height: var(--screen-height); padding-block-start: var(--header-height);
        display: grid; place-items: center; position: relative; opacity: var(--exposure, 1);
    }
    @supports (height: 100svh) { .screen { --screen-height: 100svh; } }
    .projection { width: min(100%, calc((var(--screen-height) - var(--header-height)) * 2.39)); position: relative; }
    .aperture { aspect-ratio: 239 / 100; position: relative; overflow: hidden; }
    .aperture img, .aperture video, .aperture canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .aperture video, .aperture canvas { display: none; }
    .aperture::after {
        content: ""; position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(to bottom, transparent 34%, rgb(8 11 17 / .09) 50%, rgb(8 11 17 / .42) 72%, var(--film-black) 100%);
        opacity: var(--edge, 1);
    }
    [data-active] .aperture::after { opacity: var(--edge, 0); }
    .end-credit {
        position: absolute; inset: auto 0 0; width: var(--film-content-width);
        margin-inline: auto; padding-block-end: clamp(1rem, 5svh, 3.5rem);
        color: #f9f6f3; text-shadow: 0 .04em .35em #0009;
    }
    .end-credit time {
        display: block; margin-bottom: .8rem; color: #f3bccf;
        font-size: clamp(.72rem, 1vw, .92rem); letter-spacing: .17em;
    }
    .end-credit h1 {
        margin: 0; font: 700 clamp(2rem, min(8.4vw, 16svh), 9rem)/1.02 var(--font-sans);
        letter-spacing: -.045em;
    }
    .reel[data-active]::after { content: ""; display: block; height: clamp(1100px, 200svh, 2100px); }
    [data-active] .screen { position: sticky; top: 0; }
    [data-active]:not([data-frames]) .aperture video,
    [data-frames] canvas[data-ready] { display: block; }
    [data-active] .end-credit {
        opacity: 0; pointer-events: none;
    }
    [data-active][data-finished] .end-credit { opacity: 1; transition: opacity 600ms ease-out; }
    @media (max-width: 760px), (max-width: 1100px) and (pointer: coarse) {
        .reel[data-active]::after { height: 115svh; }
    }
    @media (max-width: 760px) and (orientation: portrait), (max-width: 1100px) and (orientation: portrait) and (pointer: coarse) {
        .projection { translate: 0 -4svh; }
        .end-credit { inset: 100% 0 auto; padding-block: clamp(1.3rem, 4svh, 2.5rem) 0; }
        .end-credit h1 { font-size: clamp(2.4rem, 10vw, 5rem); }
    }
</style>
