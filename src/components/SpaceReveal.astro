---
import { withBase } from "../lib/paths";
const media = (name: string) => withBase("/media/portfolio/space-previs/" + name);
---
<header class="reel" data-reveal-reel>
    <div class="screen">
        <div class="mast">
            <h1 data-i18n-cn="星际险境" data-i18n-en="Peril in Space">星际险境</h1>
            <span data-i18n-cn="科幻短片试制 · 2025" data-i18n-en="Short film study · 2025">科幻短片试制 · 2025</span>
        </div>
        <div class="aperture">
            <picture>
                <source media="(prefers-reduced-motion: no-preference)" srcset={media("reveal-first.webp")} />
                <img src={media("black-hole-poster.webp")} alt="" width="1912" height="800" fetchpriority="high" />
            </picture>
            <video muted playsinline preload="none" aria-hidden="true" disablepictureinpicture
                data-desktop={media("reveal.mp4")} data-mobile={media("reveal-small.mp4")} data-poster={media("reveal-first.webp")}></video>
        </div>
        <div class="rail">
            <span class="cue" data-i18n-cn="滚动放映" data-i18n-en="Scroll to play">滚动放映</span>
            <span class="meter" aria-hidden="true"><i></i></span>
            <a href="#storyboard"><span data-i18n-cn="进入分镜" data-i18n-en="Storyboard">进入分镜</span> ↓</a>
        </div>
    </div>
</header>

<script>
    const reel = document.querySelector<HTMLElement>("[data-reveal-reel]");
    if (reel) {
        const screen = reel.querySelector<HTMLElement>(".screen")!;
        const video = reel.querySelector("video")!;
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        let requested = 0;
        let targetFrame = 0;
        let lastFrame = 0;
        let download: AbortController | undefined;
        let mediaUrl: string | undefined;
        const fps = 24;
        function seek() {
            if (!reel?.hasAttribute("data-active") || video.readyState < 2 || video.seeking || lastFrame === targetFrame) return;
            lastFrame = targetFrame;
            video.currentTime = (targetFrame + 0.25) / fps;
        }
        function paint() {
            requested = 0;
            if (!reel?.hasAttribute("data-active")) return;
            const bounds = reel.getBoundingClientRect();
            const distance = bounds.height - screen.offsetHeight;
            const progress = Math.min(1, Math.max(0, -bounds.top / Math.max(1, distance)));
            reel.style.setProperty("--progress", String(progress));
            if (Number.isFinite(video.duration)) {
                targetFrame = Math.round(progress * (Math.round(video.duration * fps) - 1));
                seek();
            }
        }
        function schedule() {
            if (!requested) requested = requestAnimationFrame(paint);
        }
        function reset() {
            download?.abort();
            reel!.removeAttribute("data-active");
            window.removeEventListener("scroll", schedule);
            window.removeEventListener("resize", schedule);
            if (video.hasAttribute("src")) {
                video.removeAttribute("src");
                video.load();
            }
            if (mediaUrl) URL.revokeObjectURL(mediaUrl);
            mediaUrl = undefined;
            lastFrame = targetFrame = 0;
        }
        async function configure() {
            reset();
            if (motion.matches || !video.canPlayType("video/mp4")) return;
            video.poster = video.dataset.poster!;
            video.muted = true;
            reel!.setAttribute("data-active", "");
            video.preload = "auto";
            window.addEventListener("scroll", schedule, { passive: true });
            window.addEventListener("resize", schedule);
            schedule();
            const url = (matchMedia("(max-width: 700px)").matches ? video.dataset.mobile : video.dataset.desktop)!;
            const controller = new AbortController();
            download = controller;
            try {
                const response = await fetch(url, { signal: controller.signal });
                if (!response.ok) throw new Error("Opening clip unavailable");
                const blob = await response.blob();
                if (controller.signal.aborted) return;
                mediaUrl = URL.createObjectURL(blob);
                video.src = mediaUrl;
            } catch {
                if (!controller.signal.aborted) reset();
            }
        }
        video.addEventListener("loadeddata", schedule);
        video.addEventListener("canplay", schedule);
        video.addEventListener("seeked", seek);
        video.addEventListener("error", reset);
        motion.addEventListener("change", configure);
        configure();
    }
</script>

<style>
    .reel { --progress: 0; position: relative; background: #07090c; color: #f5f1ed; }
    .screen {
        --gutter: clamp(1.2rem, 5vw, 5.5rem);
        padding: clamp(6rem, 12vh, 9rem) var(--gutter) clamp(1.25rem, 3vh, 2.5rem);
        display: flex; flex-direction: column; justify-content: center; margin: auto;
    }
    .reel[data-active]::after { content: ""; display: block; height: clamp(850px, 165svh, 1750px); }
    .reel[data-active] .screen { position: sticky; top: 0; height: 100svh; }
    .mast, .rail { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
    .mast { padding-bottom: clamp(.75rem, 2vh, 1.7rem); flex: 0 0 auto; }
    .mast h1 { margin: 0; color: inherit; font-size: clamp(2.6rem, min(7vw, 9vh), 7rem); line-height: 1.05; font-weight: 600; letter-spacing: -.055em; }
    .mast > span, .rail { font-size: clamp(.72rem, 1vw, .9rem); letter-spacing: .09em; }
    .mast > span { color: #c0b3b3; }
    .aperture { position: relative; min-height: 0; aspect-ratio: 2.39; }
    .aperture img, .aperture video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .aperture video, .cue, .meter { display: none; }
    [data-active] .aperture img { visibility: hidden; }
    [data-active] .aperture video, [data-active] .cue, [data-active] .meter { display: block; }
    .rail { align-items: center; justify-content: flex-end; color: #c8c1bc; padding-top: .8rem; }
    .rail a { text-decoration: none; color: inherit; padding-block: .4rem; }
    .rail a:hover { color: #fff; }
    .meter { flex: 1; height: 1px; background: #37353b; }
    .meter i { display: block; height: 100%; background: #ecb3b3; transform: scaleX(var(--progress)); transform-origin: left; }
    @media (max-width: 700px) {
        .screen { padding: 7.5rem 0 1.1rem; }
        .mast, .rail { margin-inline: var(--gutter); }
        .mast { flex-direction: column-reverse; gap: .75rem; padding-bottom: 1.4rem; }
        .mast h1 { font-size: clamp(2.7rem, 12vw, 4.6rem); }
        .rail { padding-top: 1rem; }
        .reel[data-active]::after { height: 115svh; }
    }
    @media (max-height: 500px) and (orientation: landscape) {
        .screen { padding: 3.25rem 4vw .25rem; }
        .mast { padding-bottom: .25rem; }
        .mast h1 { font-size: 1.5rem; }
        .rail { padding-top: 0; }
    }
</style>
