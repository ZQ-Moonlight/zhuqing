---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

const asset = (name: string) => withBase("/media/portfolio/space-previs/" + name);
const title = "星际险境";
const titleEn = "Peril in Space";
const description = "科幻短片《星际险境》的分镜与镜头试制。";
const cover = asset("black-hole-poster.webp");
const boardDescriptions = [
    ["地球夜面", "Earth at night"], ["深空飞船", "Spacecraft in deep space"], ["驾驶舱背影", "Pilot seen from behind"],
    ["舱内侧视", "Side view inside the cockpit"], ["护目镜特写", "Visor close-up"], ["舱体与操纵杆", "Cockpit controls"],
    ["行星与卫星", "Planet and moon"], ["沙尘中的地表", "Dusty landscape"], ["驾驶舱内的人物", "Pilot inside the cockpit"],
    ["透过舷窗看地表", "Landscape through the canopy"], ["荒原", "Rocky plain"], ["举起设备的主角", "Pilot lifting a device"],
    ["恒星与行星", "Star and planet"], ["战舰入画", "Warship entering the frame"], ["荒原上的人物", "Figure on the plain"],
    ["人物与身后飞船", "Pilot with a ship in the distance"], ["迎面的驾驶员", "Front view of the pilot"], ["驾驶舱仪表", "Cockpit instruments"],
    ["两艘飞船", "Two spacecraft"], ["舱内看向恒星", "Star seen from the cockpit"], ["吸积盘与飞船", "Accretion disk and spacecraft"],
    ["仰视驾驶员", "Low angle on the pilot"], ["强光下的舱体", "Cockpit in bright light"], ["蓝色吸积盘与碎片", "Debris above a blue accretion disk"],
    ["飞越吸积盘", "Flight over the accretion disk"], ["云层上的飞船", "Ship above the clouds"], ["驾驶舱内低头的主角", "Pilot leaning forward"],
    ["起火的飞船", "Spacecraft on fire"], ["暗处的仪表", "Illuminated instruments"], ["贴地飞行", "Low flight over the ground"],
    ["坠落时的舱内视角", "Cockpit view during descent"],
];
const boards = boardDescriptions.map(([cn, en], index) => ({ file: "boards/frame-" + String(index + 1).padStart(2, "0"), cn, en }));
const highlights = [1, 3, 5, 8, 10, 16, 21, 25, 28].map((n) => boards[n - 1]);
const boardGroups = [highlights, boards.filter((board) => !highlights.includes(board))];
const sequences = [
    {
        id: "earth-orbit",
        cn: "成品制作测试 · 第一镜",
        en: "Production Test · Opening Shot",
        stills: [
            { file: "earth-orbit-night", cn: "地球夜面", en: "Earth’s night side" },
            { file: "earth-orbit-pass", cn: "飞船掠过镜头", en: "Spacecraft passing the camera" },
            { file: "earth-orbit-wide", cn: "地球弧面与远处飞船", en: "Earth’s horizon and the distant spacecraft" },
            { file: "earth-orbit-poster", cn: "飞船与地球同框", en: "Spacecraft against the Earth" },
        ],
    },
    {
        id: "black-hole",
        cn: "先导概念片 · 资产与素材",
        en: "Concept Teaser · Asset Study",
        stills: [
            { file: "black-hole-occlusion", cn: "碎石遮住视野", en: "Rocks obscure the view" },
            { file: "black-hole-crossing", cn: "背光勾出碎石轮廓", en: "Backlight outlines the rocks" },
            { file: "black-hole-reveal", cn: "行星弧面与碎石", en: "The planet’s horizon and drifting rocks" },
            { file: "black-hole-poster", cn: "黑洞与吸积盘", en: "The black hole and its accretion disk" },
        ],
    },
];

const site = Astro.site ?? Astro.url.origin;
const structuredData = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: title,
    alternateName: titleEn,
    description,
    image: new URL(cover, site).toString(),
    url: new URL(withBase("/portfolio/space-previs/"), site).toString(),
};
---

<BaseLayout title={title + " | 祝庆"} description={description} activePath="/portfolio" backgroundVariant="article" image={cover} structuredData={structuredData} showInteractions={false}>
    <main class="space-project" data-space-project>
        <header class="project-hero">
            <img src={cover} alt="" width="1920" height="804" fetchpriority="high" />
            <div class="hero-copy">
                <p data-i18n-cn="科幻短片试制 · 2025" data-i18n-en="Sci-Fi Short Study · 2025">科幻短片试制 · 2025</p>
                <h1 data-i18n-cn={title} data-i18n-en={titleEn}>{title}</h1>
            </div>
        </header>

        <div class="project-content">
            <section class="sequence" aria-labelledby="storyboard">
                <h2 id="storyboard" data-i18n-cn="分镜" data-i18n-en="Storyboard">分镜</h2>
                {boardGroups.map((group, index) => {
                    const Group = index === 0 ? "div" : "details";
                    return <Group class="board-group">
                        {index > 0 && <summary data-i18n-cn="更多分镜" data-i18n-en="More frames">更多分镜</summary>}
                        <ul class="filmstrip boards" role="list">
                            {group.map((board) => <li>
                                <a href={asset(board.file + ".webp")} target="_blank" rel="noopener" data-still aria-label={board.cn} data-aria-cn={board.cn} data-aria-en={board.en}>
                                    <img src={asset(board.file + "-thumb.webp")} width="717" height="300" alt="" loading="lazy" decoding="async" />
                                </a>
                            </li>)}
                        </ul>
                    </Group>;
                })}
            </section>
            {sequences.map((sequence) => (
                <section class="sequence" aria-labelledby={sequence.id}>
                    <h2 id={sequence.id} data-i18n-cn={sequence.cn} data-i18n-en={sequence.en}>{sequence.cn}</h2>
                    <video controls playsinline preload="none" width="1920" height="804" poster={asset(sequence.id + "-poster.webp")} aria-labelledby={sequence.id}>
                        <source src={asset(sequence.id + ".mp4")} type="video/mp4" />
                        <a href={asset(sequence.id + ".mp4")} data-i18n-cn="打开视频" data-i18n-en="Open video">打开视频</a>
                    </video>
                    <ul class="filmstrip" role="list">
                        {sequence.stills.map((still) => (
                            <li>
                                <a href={asset(still.file + ".webp")} target="_blank" rel="noopener" data-still aria-label={still.cn} data-aria-cn={still.cn} data-aria-en={still.en}>
                                    <picture>
                                        <source media="(prefers-reduced-motion: no-preference)" srcset={asset(still.file + "-loop.webp")} />
                                        <img src={asset(still.file + ".webp")} width="956" height="400" alt="" loading="lazy" decoding="async" />
                                    </picture>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}
        </div>

        <dialog class="still-viewer" data-still-viewer aria-label="大图预览" data-aria-cn="大图预览" data-aria-en="Image preview">
            <form method="dialog">
                <button type="submit" aria-label="关闭预览" data-aria-cn="关闭预览" data-aria-en="Close preview">×</button>
            </form>
            <img alt="" />
        </dialog>
    </main>
</BaseLayout>

<script>
    const project = document.querySelector<HTMLElement>("[data-space-project]");
    const viewer = project?.querySelector<HTMLDialogElement>("[data-still-viewer]");
    const image = viewer?.querySelector<HTMLImageElement>("img");

    if (project && viewer && image) {
        project.querySelectorAll<HTMLAnchorElement>("[data-still]").forEach((link) => {
            link.addEventListener("click", (event) => {
                if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || typeof viewer.showModal !== "function") return;
                event.preventDefault();
                image.src = link.href;
                image.alt = link.getAttribute("aria-label") ?? "";
                viewer.showModal();
            });
        });
        viewer.addEventListener("click", (event) => {
            if (event.target === viewer) viewer.close();
        });
    }
</script>

<style>
    .space-project {
        --film-black: #080b11;
        --film-white: #f4f2f0;
        --film-line: #ffffff26;
        --film-accent: #f0b7cd;
        background: var(--film-black);
        color: var(--film-white);
    }

    .project-hero {
        position: relative;
        isolation: isolate;
        display: grid;
        align-items: end;
        aspect-ratio: 2.39;
    }

    .project-hero > img,
    .project-hero::after {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .project-hero > img {
        z-index: -2;
        object-fit: cover;
        object-position: center 42%;
    }

    .project-hero::after {
        content: "";
        z-index: -1;
        background: linear-gradient(0deg, var(--film-black), #080b11aa 23%, #080b1100 57%);
    }

    .hero-copy,
    .project-content {
        width: min(86rem, calc(100% - clamp(2rem, 8vw, 8rem)));
        margin-inline: auto;
    }

    .hero-copy { padding-block: 4rem 2.5rem; }

    .hero-copy p {
        margin: 0 0 0.75rem;
        color: var(--film-accent);
        font-size: 0.875rem;
        letter-spacing: 0.16em;
    }

    h1 {
        margin: 0;
        color: var(--film-white);
        font-size: clamp(3.6rem, 10vw, 9rem);
        font-weight: 650;
        letter-spacing: -0.04em;
        line-height: 0.98;
        text-wrap: balance;
    }

    .project-content { padding-block: clamp(1.5rem, 5vw, 5rem) clamp(4rem, 9vw, 8rem); }

    .sequence + .sequence { margin-top: clamp(3.5rem, 9vw, 8rem); }

    h2 {
        margin: 0 0 1.15rem;
        color: var(--film-white);
        font-size: clamp(1.4rem, 3.2vw, 2.5rem);
        font-weight: 550;
        letter-spacing: 0.02em;
    }

    video {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 2.39;
        border: 1px solid var(--film-line);
        border-radius: 0.45rem;
        background: #030508;
    }

    .filmstrip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: clamp(0.45rem, 1.1vw, 1rem);
        margin: clamp(0.5rem, 1.4vw, 1.2rem) 0 0;
        padding: 0;
        list-style: none;
    }

    .filmstrip a {
        display: block;
        overflow: hidden;
        border: 1px solid var(--film-line);
        border-radius: 0.3rem;
        background: #030508;
    }

    .filmstrip img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 2.39;
        object-fit: cover;
        transition: transform 220ms ease;
    }

    .filmstrip a:hover img { transform: scale(1.04); }
    .boards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .board-group summary { width: fit-content; margin-block: 1.1rem; cursor: pointer; color: var(--film-accent); }

    a:focus-visible,
    video:focus-visible,
    button:focus-visible {
        outline: 2px solid var(--film-accent);
        outline-offset: 3px;
    }

    .still-viewer {
        margin: auto;
        max-width: min(94vw, 100rem);
        max-height: 94vh;
        padding: 0;
        overflow: visible;
        border: 0;
        background: #030508;
        color: var(--film-white);
    }

    .still-viewer::backdrop { background: #030508ee; }

    .still-viewer img {
        display: block;
        max-width: 100%;
        max-height: 82vh;
        object-fit: contain;
    }

    .still-viewer button {
        position: absolute;
        top: 0.55rem;
        right: 0.55rem;
        display: grid;
        place-items: center;
        width: 2.75rem;
        aspect-ratio: 1;
        border: 1px solid var(--film-line);
        border-radius: 50%;
        background: #080b11e6;
        color: var(--film-white);
        font-size: 1.55rem;
        cursor: pointer;
    }

    @media (max-width: 40rem) {
        .project-hero { margin-top: 4.5rem; }
        .hero-copy { padding-block: 0.75rem; }
        h1 { font-size: clamp(2rem, 9vw, 3.6rem); }
        .filmstrip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (prefers-reduced-motion: reduce) {
        .filmstrip img { transition: none; }
    }
</style>
