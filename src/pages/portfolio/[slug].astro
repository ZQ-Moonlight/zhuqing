---
import { getCollection, render } from "astro:content";
import { stat } from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ClickToPlayBilibili from "../../components/ClickToPlayBilibili.astro";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
    const cases = await getCollection("portfolio");
    return cases.filter((item) => item.id !== "guangying-changqing").map((item) => ({
        params: { slug: item.id },
        props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const isGuangyingCase = item.id === "guangying-changqing";
const archiveUrl = isGuangyingCase ? withBase("/blog/guangying-changqing-workflow/") : undefined;
const heroImage = withBase(item.data.heroImage);
const coverImage = item.data.coverImage ? withBase(item.data.coverImage) : undefined;
const documentUrl = item.data.documentUrl ? withBase(item.data.documentUrl) : undefined;
const primaryVideoUrl = item.data.videoUrl ? withBase(item.data.videoUrl) : undefined;
const secondaryVideoUrl = item.data.secondaryVideoUrl ? withBase(item.data.secondaryVideoUrl) : undefined;
const hasVideo = Boolean(item.data.videoBvid || primaryVideoUrl);
const stepFor = (index: number) => String(index).padStart(2, "0");
const formatBytes = (bytes: number) => {
    if (bytes >= 1024 * 1024) return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
    return `${Math.max(1, Math.round(bytes / 1024))} KB`;
};
const formatDateLabel = (date?: Date) =>
    date
        ? new Intl.DateTimeFormat("zh-CN", {
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
          }).format(date)
        : undefined;
const getPublicFileStat = async (url: string) => {
    try {
        const cleanPath = url.replace(/^\/+/, "").split(/[?#]/)[0];
        return await stat(path.join(process.cwd(), "public", ...cleanPath.split("/")));
    } catch {
        return undefined;
    }
};
const videoTypeFor = (url: string) => {
    const lower = url.toLowerCase();
    if (lower.endsWith(".mp4")) return "video/mp4";
    if (lower.endsWith(".mov")) return "video/quicktime";
    if (lower.endsWith(".webm")) return "video/webm";
    return undefined;
};
const documentFileStat = item.data.documentUrl ? await getPublicFileStat(item.data.documentUrl) : undefined;
const documentSizeLabel = documentFileStat ? formatBytes(documentFileStat.size) : undefined;
const documentUploadedLabel = formatDateLabel(item.data.documentUploadedDate ?? documentFileStat?.mtime ?? item.data.pubDate);
const pageUrl = new URL(withBase(`/portfolio/${item.id}/`), Astro.site ?? Astro.url.origin).toString();
const structuredData = {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: item.data.title,
    headline: item.data.title,
    description: item.data.description,
    image: new URL(heroImage, Astro.site ?? Astro.url.origin).toString(),
    url: pageUrl,
    datePublished: item.data.pubDate?.toISOString(),
    keywords: item.data.tags,
    creator: {
        "@type": "Person",
        name: "祝庆",
        alternateName: "Zhu Qing",
    },
};
const caseNav =
    item.id === "ue-cinematics-pipeline"
        ? [
              { href: "#overview", label: "项目概述" },
              { href: "#complete-demo", label: "完整演示" },
              { href: "#blockout", label: "白模与地图" },
              { href: "#sequencer", label: "Sequencer" },
              { href: "#blueprints", label: "蓝图" },
              { href: "#scan-fx", label: "扫描特效" },
              { href: "#memory-palace", label: "记忆宫殿" },
              { href: "#ui", label: "UI" },
              { href: "#rain", label: "雨水材质" },
              { href: "#lessons", label: "复盘" },
              { href: "#checklist", label: "检查清单" },
          ]
        : [];
const relatedAssetLinks =
    item.id === "ue-cinematics-pipeline"
        ? [
              {
                  href: withBase("/portfolio/detroit/"),
                  chip: "作品页",
                  title: "查看《底特律：化身为人》UE5 复刻主页面",
                  description: "主页面偏最终展示和项目说明，本页偏制作过程与技术拆分。",
              },
          ]
        : [];
---

<BaseLayout
    title={`${item.data.title} | 作品 | 祝庆 Zhu Qing`}
    description={item.data.description}
    activePath="/portfolio"
    backgroundVariant="article"
    image={item.data.heroImage}
    preloadImage={item.data.heroImage}
    structuredData={structuredData}
>
    <section class="case-detail-hero">
        <img src={heroImage} alt="" loading="eager" fetchpriority="high" />
        <div class="case-detail-hero__shade"></div>
        <div class="case-detail-hero__content" data-reveal>
            <a class="case-back-link" href={withBase("/portfolio")} data-i18n-cn="返回作品集 / Works" data-i18n-en="Back to Works">返回作品集 / Works</a>
            <span class="eyebrow">{item.data.category}</span>
            <h1>{item.data.title}</h1>
            {item.data.subtitle && <p class="subtitle">{item.data.subtitle}</p>}
            <p>{item.data.description}</p>
            {item.data.tags.length > 0 && (
                <div class="case-tags">
                    {item.data.tags.map((tag) => <span>{tag}</span>)}
                </div>
            )}
        </div>
    </section>

    {caseNav.length > 0 && (
        <nav class="chapter-nav" aria-label="Case study chapters">
            {caseNav.map((link) => (
                <a href={link.href}>{link.label}</a>
            ))}
        </nav>
    )}

    <main class="case-detail">
        {hasVideo && (
            <section class="case-block" data-reveal>
                <div class="case-block__head">
                    <span>01</span>
                    <h2>演示视频</h2>
                </div>
                <div class="video-wrapper">
                    {item.data.videoBvid ? (
                        <ClickToPlayBilibili
                            bvid={item.data.videoBvid}
                            title={item.data.videoTitle ?? item.data.title}
                            poster={item.data.videoPoster ?? item.data.heroImage}
                            eyebrow="Bilibili Video"
                            heading="点击播放"
                            description={item.data.description}
                        />
                    ) : (
                        <video controls preload="metadata" poster={heroImage}>
                            <source src={primaryVideoUrl} type={primaryVideoUrl ? videoTypeFor(primaryVideoUrl) : undefined} />
                            你的浏览器不支持 HTML5 视频播放。
                        </video>
                    )}
                </div>
                {secondaryVideoUrl && (
                    <div class="secondary-video">
                        <span class="category">{item.data.secondaryVideoTitle ?? "Behind the Scenes"}</span>
                        <video controls preload="metadata" poster={heroImage}>
                            <source src={secondaryVideoUrl} type={videoTypeFor(secondaryVideoUrl)} />
                            你的浏览器不支持此视频格式。
                        </video>
                    </div>
                )}
            </section>
        )}

        <section class="case-block">
            <div class="case-block__head">
                <span>{hasVideo ? "02" : "01"}</span>
                <h2 data-i18n-cn="项目记录" data-i18n-en="Project Notes">项目记录</h2>
            </div>
            {archiveUrl && (
                <a class="archive-jump" href={archiveUrl}>
                    <span class="category" data-i18n-cn="完整技术档案 / Markdown Archive" data-i18n-en="Full Technical Archive">完整技术档案 / Markdown Archive</span>
                    <strong>查看《光影长青》创新影像项目技术工作流</strong>
                    <small>包含高斯泼溅场景重建、MetaHuman 数字人、UE5.6 渲染、动作捕捉与后期点云动画的完整记录。</small>
                    <em data-i18n-cn="跳转到档案页面" data-i18n-en="Open Archive Article">跳转到档案页面</em>
                </a>
            )}
            <article class="case-prose">
                <Content />
            </article>
        </section>

        {(coverImage || documentUrl || relatedAssetLinks.length > 0) && (
            <section class="case-block case-assets" data-reveal>
                <div class="case-block__head">
                    <span>{stepFor(hasVideo ? 3 : 2)}</span>
                    <h2 data-i18n-cn="项目资料" data-i18n-en="Project Assets">项目资料</h2>
                </div>
                <div class="asset-grid">
                    {coverImage && (
                        <figure>
                            <img src={coverImage} alt={`${item.data.title} poster`} loading="lazy" />
                            <figcaption>项目海报</figcaption>
                        </figure>
                    )}
                    {documentUrl && (
                        <a class="document-card" href={documentUrl} target="_blank" rel="noreferrer">
                            <span class="file-chip">PDF</span>
                            <strong>{item.data.documentLabel ?? "查看项目文档"}</strong>
                            <small>技术流程、制作记录与项目复盘</small>
                            {(documentSizeLabel || documentUploadedLabel) && (
                                <span class="document-meta">
                                    {documentSizeLabel && <span>{documentSizeLabel}</span>}
                                    {documentUploadedLabel && <span>{documentUploadedLabel}</span>}
                                </span>
                            )}
                        </a>
                    )}
                    {relatedAssetLinks.map((link) => (
                        <a class="document-card" href={link.href}>
                            <span class="file-chip file-chip--muted">{link.chip}</span>
                            <strong>{link.title}</strong>
                            <small>{link.description}</small>
                        </a>
                    ))}
                </div>
            </section>
        )}
    </main>

    <div class="image-lightbox" data-image-lightbox aria-hidden="true">
        <button class="image-lightbox__close" type="button" data-image-lightbox-close aria-label="关闭图片预览">关闭</button>
        <img src="" alt="" data-image-lightbox-image />
        <p data-image-lightbox-caption></p>
    </div>

    <footer class="site-footer">© 2026 祝庆 Zhu Qing</footer>
</BaseLayout>

<script>
    const lightbox = document.querySelector("[data-image-lightbox]");
    const lightboxImage = document.querySelector("[data-image-lightbox-image]") as HTMLImageElement | null;
    const lightboxCaption = document.querySelector("[data-image-lightbox-caption]");
    const lightboxClose = document.querySelector("[data-image-lightbox-close]");

    const closeLightbox = () => {
        lightbox?.setAttribute("aria-hidden", "true");
        document.documentElement.classList.remove("has-image-lightbox");
        if (lightboxImage) {
            lightboxImage.removeAttribute("src");
            lightboxImage.alt = "";
        }
        if (lightboxCaption) lightboxCaption.textContent = "";
    };

    document.querySelectorAll(".case-prose img").forEach((image) => {
        image.setAttribute("data-zoomable-image", "true");
        image.setAttribute("tabindex", "0");
        image.setAttribute("role", "button");

        const open = () => {
            if (!lightbox || !lightboxImage) return;
            const source = image.getAttribute("src");
            if (!source) return;
            const caption = image.closest("figure")?.querySelector("figcaption")?.textContent?.trim() ?? image.getAttribute("alt") ?? "";

            lightboxImage.src = source;
            lightboxImage.alt = image.getAttribute("alt") ?? caption;
            if (lightboxCaption) lightboxCaption.textContent = caption;
            lightbox.setAttribute("aria-hidden", "false");
            document.documentElement.classList.add("has-image-lightbox");
        };

        image.addEventListener("click", open);
        image.addEventListener("keydown", (event) => {
            if (event instanceof KeyboardEvent && (event.key === "Enter" || event.key === " ")) {
                event.preventDefault();
                open();
            }
        });
    });

    document.querySelectorAll(".process-video").forEach((video) => {
        video.addEventListener("play", () => video.classList.add("is-playing"));
        video.addEventListener("pause", () => video.classList.remove("is-playing"));
        video.addEventListener("ended", () => video.classList.remove("is-playing"));
    });

    lightboxClose?.addEventListener("click", closeLightbox);
    lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeLightbox();
    });
</script>

<style>
    .case-detail-hero {
        position: relative;
        z-index: 10;
        min-height: 78vh;
        display: grid;
        align-items: end;
        overflow: hidden;
        background: #000;
    }

    .case-detail-hero > img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.48) contrast(1.08) saturate(0.86);
    }

    .case-detail-hero__shade {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(0deg, rgba(5, 5, 5, 0.96), rgba(5, 5, 5, 0.18) 48%, rgba(5, 5, 5, 0.62)),
            linear-gradient(90deg, rgba(5, 5, 5, 0.78), transparent 68%);
    }

    .case-detail-hero__content {
        position: relative;
        z-index: 2;
        width: min(900px, 100%);
        padding: calc(var(--header-height) + 74px) var(--page-x) 10vh;
    }

    .case-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        width: fit-content;
        margin-bottom: 18px;
        border: 1px solid rgba(255, 255, 255, 0.34);
        border-radius: 999px;
        background: rgba(5, 5, 5, 0.54);
        color: #fff;
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.04em;
        padding: 8px 13px;
        text-decoration: none;
        transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
    }

    .case-back-link::before {
        content: "\2190";
        color: var(--accent);
        font-size: 0.92rem;
        line-height: 1;
    }

    .case-back-link:hover {
        border-color: rgba(255, 94, 0, 0.58);
        background: rgba(255, 94, 0, 0.2);
        color: #fff;
    }

    .case-detail-hero h1 {
        margin: 14px 0 12px;
        color: #fff;
        font-family: var(--font-display);
        font-size: var(--title-article);
        line-height: 1.06;
        text-wrap: balance;
    }

    .case-detail-hero p {
        max-width: 760px;
        margin: 0;
        color: #d4d4d8;
        font-size: var(--text-lead);
        line-height: 1.76;
    }

    .case-detail-hero .subtitle {
        margin-bottom: 14px;
        color: #d4d4d8;
        font-family: var(--font-mono);
        font-size: 0.86rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .case-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 24px;
    }

    .case-tags span {
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        color: #d4d4d8;
        font-size: 0.76rem;
        padding: 4px 10px;
    }

    .case-detail {
        position: relative;
        z-index: 10;
        width: min(100%, 1040px);
        margin: 0 auto;
        padding: 74px var(--page-x) 100px;
    }

    .chapter-nav {
        position: sticky;
        top: var(--header-height);
        z-index: 70;
        display: flex;
        justify-content: center;
        gap: clamp(12px, 2.4vw, 26px);
        padding: 14px var(--page-x);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: rgba(5, 5, 5, 0.82);
        backdrop-filter: blur(14px);
        overflow-x: auto;
    }

    .chapter-nav a {
        flex: 0 0 auto;
        color: var(--text-muted);
        font-size: 0.84rem;
        text-decoration: none;
        white-space: nowrap;
        transition: color 180ms ease;
    }

    .chapter-nav a:hover {
        color: var(--text-main);
    }

    .case-block {
        margin-bottom: 92px;
    }

    .case-block__head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 30px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border);
    }

    .case-block__head h2 {
        margin: 0;
        color: var(--text-main);
        font-family: var(--font-display);
        font-size: var(--title-section);
    }

    .case-block__head span {
        order: 2;
        color: rgba(255, 255, 255, 0.16);
        font-family: var(--font-mono);
        font-size: clamp(1.55rem, 3vw, 2.4rem);
        font-weight: 760;
        line-height: 1;
    }

    .video-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #111;
    }

    .video-wrapper video,
    .secondary-video video {
        width: 100%;
        height: 100%;
        display: block;
        background: #050505;
    }

    .video-wrapper video {
        object-fit: contain;
    }

    .secondary-video {
        display: grid;
        gap: 12px;
        margin-top: 24px;
    }

    .secondary-video video {
        aspect-ratio: 16 / 9;
        border: 1px solid var(--border);
        border-radius: 8px;
        object-fit: contain;
    }

    .case-prose {
        color: var(--text-muted);
        font-size: var(--text-body);
        line-height: 1.9;
    }

    .archive-jump {
        display: grid;
        gap: 10px;
        margin: 0 0 36px;
        border: 1px solid rgba(255, 94, 0, 0.32);
        border-left: 4px solid var(--accent);
        border-radius: 8px;
        background:
            linear-gradient(90deg, rgba(255, 94, 0, 0.12), rgba(255, 255, 255, 0.035)),
            var(--bg-panel);
        color: inherit;
        padding: clamp(20px, 3vw, 28px);
        text-decoration: none;
        transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
    }

    .archive-jump:hover {
        border-color: rgba(255, 94, 0, 0.58);
        background:
            linear-gradient(90deg, rgba(255, 94, 0, 0.16), rgba(255, 255, 255, 0.055)),
            var(--bg-panel-strong);
        transform: translateY(-2px);
    }

    .archive-jump strong {
        color: var(--text-main);
        font-family: var(--font-display);
        font-size: clamp(1.14rem, 2vw, 1.42rem);
        line-height: 1.32;
    }

    .archive-jump small {
        max-width: 760px;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.72;
    }

    .archive-jump em {
        width: fit-content;
        color: var(--accent);
        font-style: normal;
        font-weight: 760;
        line-height: 1.3;
    }

    .archive-jump em::after {
        content: "\2192";
        margin-left: 8px;
    }

    :root[data-theme="light"] .archive-jump {
        background:
            linear-gradient(90deg, rgba(200, 79, 18, 0.1), rgba(255, 255, 255, 0.72)),
            var(--bg-panel);
        border-color: rgba(200, 79, 18, 0.28);
        box-shadow: 0 16px 38px rgba(32, 28, 22, 0.06);
    }

    .case-prose :global(h2),
    .case-prose :global(h3) {
        color: var(--text-main);
        font-family: var(--font-display);
        line-height: 1.28;
        scroll-margin-top: calc(var(--header-height) + 36px);
    }

    .case-prose :global(h2) {
        margin: 2.4rem 0 1rem;
        font-size: var(--title-section);
    }

    .case-prose :global(h3) {
        margin: 2rem 0 0.8rem;
        font-size: var(--title-card);
    }

    .case-prose :global(p) {
        margin: 0 0 1.5rem;
    }

    .case-prose :global(strong) {
        color: var(--text-main);
    }

    .case-prose :global(ul),
    .case-prose :global(ol) {
        display: grid;
        gap: 0.65rem;
        margin: 0 0 1.5rem;
        padding-left: 1.2rem;
    }

    .case-prose :global(li) {
        color: var(--text-muted);
        line-height: 1.82;
    }

    .case-prose :global(img) {
        display: block;
        width: min(100%, 920px);
        height: auto;
        margin: 2rem auto 0.8rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #111;
    }

    .case-prose :global(img[data-zoomable-image="true"]) {
        cursor: zoom-in;
        transition: border-color 180ms ease, filter 180ms ease, transform 180ms ease;
    }

    .case-prose :global(img[data-zoomable-image="true"]:hover),
    .case-prose :global(img[data-zoomable-image="true"]:focus-visible) {
        border-color: rgba(255, 94, 0, 0.46);
        filter: brightness(1.08) saturate(1.04);
    }

    .case-prose :global(img[data-zoomable-image="true"]:focus-visible) {
        outline: 2px solid rgba(255, 94, 0, 0.52);
        outline-offset: 3px;
    }

    .case-prose :global(img[alt="现场拍摄参考"]) {
        width: min(100%, 560px);
    }

    .case-prose :global(figure) {
        margin: 2rem 0;
    }

    .case-prose :global(figcaption) {
        margin-top: 0.72rem;
        color: var(--text-dim);
        font-size: 0.84rem;
        line-height: 1.58;
        text-align: center;
    }

    .case-prose :global(video) {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #050505;
        object-fit: contain;
    }

    .case-prose :global(.process-video) {
        filter: brightness(0.84) contrast(1.06) saturate(0.94);
    }

    .case-prose :global(.process-video.is-playing) {
        filter: brightness(0.74) contrast(1.08) saturate(0.92);
    }

    .case-prose :global(.bilibili-inline iframe) {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #050505;
    }

    .case-prose :global(a[target="_blank"]),
    .case-prose :global(a[href^="https://www.bilibili.com"]) {
        color: var(--accent);
        font-weight: 760;
        text-decoration: none;
    }

    .case-prose :global(a[target="_blank"]:hover),
    .case-prose :global(a[href^="https://www.bilibili.com"]:hover) {
        text-decoration: underline;
    }

    .case-prose :global(.media-grid) {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin: 2rem 0;
    }

    .case-prose :global(.media-grid figure) {
        margin: 0;
    }

    .case-prose :global(.media-grid img) {
        width: 100%;
        aspect-ratio: 16 / 9;
        max-height: 520px;
        margin: 0;
        object-fit: contain;
        background: #050505;
    }

    .case-prose :global(.stage-strip) {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin: 2rem 0;
    }

    .case-prose :global(.stage-strip figure) {
        margin: 0;
    }

    .case-prose :global(.stage-strip img) {
        width: 100%;
        aspect-ratio: 4 / 3;
        margin: 0;
        object-fit: contain;
