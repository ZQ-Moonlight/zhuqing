---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClickToPlayBilibili from "../components/ClickToPlayBilibili.astro";
import { getReferenceGroups } from "../lib/contentArchive";
import { withBase } from "../lib/paths";

const shareDocs = (await getReferenceGroups()).find((group) => group.label === "分享资料")?.items ?? [];
const shareDocCopy: Record<string, { titleEn: string; descriptionEn?: string }> = {
    "影像册 V1": {
        titleEn: "Image Collection V1",
        descriptionEn: "A staged image collection centered on photography, showing visual observation, narrative mood, and image organization.",
    },
    "DIT 快速入门手册 V1.1": {
        titleEn: "DIT Quick Start Guide V1.1",
        descriptionEn: "A DIT workflow guide for on-set media management, transcoding, verification, backup, and data handoff.",
    },
};
const getShareDocCopy = (title: string) => shareDocCopy[title] ?? { titleEn: title };
const stereoCalculatorUrl = "https://zq-moonlight.github.io/Stereoscopic-3D-Camera-Base-Calculator/";
const duboisAnaglyphUrl = "https://github.com/ZQ-Moonlight/dubois-anaglyph-converter";
const guangyingWorkflowUrl = withBase("/blog/guangying-changqing-workflow/");
const reelItems = [
    {
        titleCn: "银翼杀手2049 仿拍后期视效分解",
        titleEn: "Blade Runner 2049 Inspired VFX Breakdown",
        categoryCn: "VFX / Breakdown / Compositing",
        categoryEn: "VFX / Breakdown / Compositing",
        descriptionCn: "以《银翼杀手2049》的影像气质为参考，展示仿拍镜头的后期视效制作过程、画面氛围塑造与前后对比。",
        descriptionEn: "A VFX breakdown for a Blade Runner 2049-inspired recreation, covering compositing, atmosphere, and before-after comparisons.",
        bvid: "BV1nZMg6XEDq",
        page: 1,
        poster: "/media/portfolio/reel-covers/blade-runner-2049-vfx.png",
        duration: "P1",
        tags: ["VFX", "Breakdown", "2049"],
    },
    {
        titleCn: "Houdini 导入 UE 程序化破损练习过程",
        titleEn: "Houdini to UE Procedural Fracture Study",
        categoryCn: "Houdini / Unreal Engine / Procedural",
        categoryEn: "Houdini / Unreal Engine / Procedural",
        descriptionCn: "记录 Houdini 程序化破损资产的制作思路，以及导入 Unreal Engine 后的材质、展示和镜头效果测试。",
        descriptionEn: "A Houdini procedural fracture study brought into Unreal Engine, covering asset setup, materials, presentation, and shot tests.",
        bvid: "BV1nZMg6XEDq",
        page: 2,
        poster: "/media/portfolio/reel-covers/houdini-ue-fracture.jpg",
        duration: "P2",
        tags: ["Houdini", "UE", "Procedural"],
    },
    {
        titleCn: "短片人物换脸 VFX",
        titleEn: "Short Film Face Swap VFX",
        categoryCn: "VFX / Face Swap / Short Film",
        categoryEn: "VFX / Face Swap / Short Film",
        descriptionCn: "短片项目中的人物换脸视效测试，重点关注面部替换后的匹配、融合、光影一致性和镜头内自然度。",
        descriptionEn: "A short-film face swap VFX test focused on matching, blending, lighting consistency, and shot-level believability.",
        bvid: "BV1nZMg6XEDq",
        page: 3,
        poster: "/media/portfolio/reel-covers/face-replacement-vfx.jpg",
        duration: "P3",
        tags: ["Face Swap", "VFX", "Compositing"],
    },
    {
        titleCn: "DaVinci 调色练习 Reel",
        titleEn: "DaVinci Resolve Color Grading Reel",
        categoryCn: "Color Grading / DaVinci Resolve",
        categoryEn: "Color Grading / DaVinci Resolve",
        descriptionCn: "DaVinci Resolve 调色练习整理，包含不同画面风格、色彩倾向和影调控制的阶段性测试。",
        descriptionEn: "A DaVinci Resolve color grading reel collecting style, color direction, and tonal-control studies.",
        bvid: "BV1nZMg6XEDq",
        page: 4,
        poster: "/media/portfolio/reel-covers/davinci-color-reel.jpg",
        duration: "P4",
        tags: ["DaVinci", "Color", "Reel"],
    },
];
const portfolioUrl = new URL(withBase("/portfolio/"), Astro.site ?? Astro.url.origin).toString();
const collectionStructuredData = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "作品集 | 祝庆 Zhu Qing",
    description: "祝庆的影视后期、UE5 交互、MetaHuman 与数字人工作流部分作品。",
    url: portfolioUrl,
    mainEntity: {
        "@type": "ItemList",
        itemListElement: [
            { "@type": "CreativeWork", name: "UE5 剧情动画与交互扫描流程", url: new URL(withBase("/portfolio/ue-cinematics-pipeline/"), Astro.site ?? Astro.url.origin).toString() },
            { "@type": "CreativeWork", name: "《底特律：化身为人》场景与交互复刻", url: new URL(withBase("/portfolio/detroit/"), Astro.site ?? Astro.url.origin).toString() },
            { "@type": "CreativeWork", name: "MetaHuman 与数字人光场流程", url: new URL(withBase("/portfolio/metahuman/"), Astro.site ?? Astro.url.origin).toString() },
            { "@type": "CreativeWork", name: "《光影长青》", url: new URL(withBase("/portfolio/guangying-changqing/"), Astro.site ?? Astro.url.origin).toString() },
            { "@type": "CreativeWork", name: "《光影长青》创新影像项目技术工作流", url: new URL(guangyingWorkflowUrl, Astro.site ?? Astro.url.origin).toString() },
            { "@type": "CreativeWork", name: "nDisplay 虚拟拍摄主摄影系统构建", url: new URL(withBase("/portfolio/ndisplay/"), Astro.site ?? Astro.url.origin).toString() },
            { "@type": "SoftwareApplication", name: "Stereoscopic 3D Camera Base Calculator", url: stereoCalculatorUrl },
            { "@type": "SoftwareApplication", name: "Dubois Anaglyph Converter", url: duboisAnaglyphUrl },
        ],
    },
};
---

<BaseLayout
    title="作品集 | 祝庆 Zhu Qing"
    description="祝庆的影视后期、UE5 交互、MetaHuman 与数字人工作流部分作品。"
    activePath="/portfolio"
    backgroundVariant="portfolio"
    structuredData={collectionStructuredData}
>
    <main class="page-shell portfolio-layout">
        <header class="portfolio-hero" data-reveal>
            <span class="eyebrow" data-i18n-cn="作品 / 流程 / 后期" data-i18n-en="Works / Pipeline / Post">作品 / 流程 / 后期</span>
            <h1 data-i18n-cn="部分作品 Works" data-i18n-en="Selected Works">部分作品 Works</h1>
            <p data-i18n-cn="UE 实时过场动画、交互叙事流程、数字人技术研究、影视后期调色与电影放映。" data-i18n-en="Unreal Engine cinematics, interactive narrative pipelines, digital-human research, post-production color work, and cinema delivery.">UE 实时过场动画、交互叙事流程、数字人技术研究、影视后期调色与电影放映。</p>
        </header>

        <section class="work-section" aria-labelledby="works-title">
            <div class="section-heading" data-reveal>
                <h2 id="works-title" data-i18n-cn="部分项目" data-i18n-en="Projects">部分项目</h2>
            </div>

            <div class="work-grid">
                <a href={withBase("/portfolio/ue-cinematics-pipeline")} class="project-card" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/ue-cinematics-pipeline/images/cover.webp")} alt="UE5 cinematic integration and scan workflow" loading="lazy" />
                        <span class="card-hover" data-i18n-cn="查看流程文档" data-i18n-en="View Pipeline Notes">查看流程文档</span>
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="UE5 / Cinematics / 技术导演" data-i18n-en="UE5 / Cinematics / Technical Direction">UE5 / Cinematics / 技术导演</span>
                        <h3 data-i18n-cn="UE5 剧情动画与交互扫描流程" data-i18n-en="UE5 Cinematic and Interactive Scan Pipeline">UE5 剧情动画与交互扫描流程</h3>
                        <p data-i18n-cn="从白模、Sequencer、蓝图触发、扫描特效、UI 到雨水材质的过程复盘，强调如何把剧情动画落到可交互引擎片段。" data-i18n-en="A process case study covering blockout, Sequencer, Blueprint triggers, scan effects, UI, and rain shaders for an interactive cinematic sequence.">从白模、Sequencer、蓝图触发、扫描特效、UI 到雨水材质的过程复盘，强调如何把剧情动画落到可交互引擎片段。</p>
                    </div>
                </a>

                <a href={withBase("/portfolio/detroit")} class="project-card" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/detroit/images/cover.webp")} alt="Detroit Become Human UE5 recreation" loading="lazy" />
                        <span class="card-hover" data-i18n-cn="查看技术复盘" data-i18n-en="View Case Study">查看技术复盘</span>
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="UE5 / 交互叙事" data-i18n-en="UE5 / Interactive Narrative">UE5 / 交互叙事</span>
                        <h3 data-i18n-cn="《底特律：化身为人》场景与交互复刻" data-i18n-en="Detroit: Become Human Scene & Interaction Recreation">《底特律：化身为人》场景与交互复刻</h3>
                        <p data-i18n-cn="章节级交互还原，包含蓝图 QTE、关卡序列、环境扫描、虚拟制片适配与镜头流程复盘。" data-i18n-en="A chapter-level interactive recreation covering Blueprint QTEs, level sequences, environmental scanning, virtual-production adaptation, and camera workflow notes.">章节级交互还原，包含蓝图 QTE、关卡序列、环境扫描、虚拟制片适配与镜头流程复盘。</p>
                    </div>
                </a>

                <a href={withBase("/portfolio/metahuman")} class="project-card" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/metahuman/images/lightstage-article-cover.webp")} alt="MetaHuman and Light Stage workflow" loading="lazy" />
                        <span class="card-hover" data-i18n-cn="查看数字人流程" data-i18n-en="View Digital-Human Pipeline">查看数字人流程</span>
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="数字人 / 工作流" data-i18n-en="Digital Human / Workflow">数字人 / 工作流</span>
                        <h3 data-i18n-cn="MetaHuman 与数字人光场流程" data-i18n-en="MetaHuman and Digital-Human Light-Stage Pipeline">MetaHuman 与数字人光场流程</h3>
                        <p data-i18n-cn="研究数字人资产规范、表情/材质流程与高精度光照采集，探索实时数字人的视觉可信度边界。" data-i18n-en="Research into digital-human asset standards, facial and material workflows, and high-precision lighting capture for believable real-time characters.">研究数字人资产规范、表情/材质流程与高精度光照采集，探索实时数字人的视觉可信度边界。</p>
                    </div>
                </a>

                <a href={withBase("/portfolio/guangying-changqing")} class="project-card" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/guangying-changqing/images/still.webp")} alt="Light and Shadow Changqing digital image work" loading="lazy" />
                        <span class="card-hover" data-i18n-cn="查看项目复盘" data-i18n-en="View Project Notes">查看项目复盘</span>
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="数字人 / 高斯泼溅 / 叙事短片" data-i18n-en="Digital Human / Gaussian Splatting / Narrative Film">数字人 / 高斯泼溅 / 叙事短片</span>
                        <h3 data-i18n-cn="《光影长青》" data-i18n-en="Light and Shadow, Evergreen">《光影长青》</h3>
                        <p data-i18n-cn="结合 MetaHuman 数字人、高斯泼溅校园场景重建与人文叙事，完成一段跨越时空的影像对话。" data-i18n-en="A time-spanning visual dialogue combining MetaHuman digital humans, Gaussian Splatting campus reconstruction, and humanistic narrative design.">结合 MetaHuman 数字人、高斯泼溅校园场景重建与人文叙事，完成一段跨越时空的影像对话。</p>
                    </div>
                </a>

                <a href={withBase("/portfolio/ndisplay")} class="project-card" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/ndisplay/images/cover.webp")} alt="nDisplay ICVFX LED volume workflow" loading="lazy" />
                        <span class="card-hover" data-i18n-cn="查看虚拟拍摄流程" data-i18n-en="View Virtual-Production Workflow">查看虚拟拍摄流程</span>
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="nDisplay / ICVFX / 虚拟拍摄" data-i18n-en="nDisplay / ICVFX / Virtual Production">nDisplay / ICVFX / 虚拟拍摄</span>
                        <h3 data-i18n-cn="nDisplay 虚拟拍摄主摄影系统构建" data-i18n-en="nDisplay Virtual-Production Camera System">nDisplay 虚拟拍摄主摄影系统构建</h3>
                        <p data-i18n-cn="围绕 LED 背景墙、nDisplay 配置、实时内容播放与主摄影机视角管理，整理 ICVFX 现场拍摄流程。" data-i18n-en="An ICVFX workflow organized around LED volumes, nDisplay configuration, real-time playback, and main-camera viewpoint management.">围绕 LED 背景墙、nDisplay 配置、实时内容播放与主摄影机视角管理，整理 ICVFX 现场拍摄流程。</p>
                    </div>
                </a>

                <article class="project-card project-card--summary" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/post-production/images/dcp-screening.webp")} alt="DCP screening on Barco projector" loading="lazy" />
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="DCP / 电影节字幕" data-i18n-en="DCP / Festival Subtitles">DCP / 电影节字幕</span>
                        <span class="card-status" data-i18n-cn="项目简述" data-i18n-en="Brief">项目简述</span>
                        <h3 data-i18n-cn="电影节 DCP 与外挂字幕放映" data-i18n-en="Festival DCP and External Subtitle Screening">电影节 DCP 与外挂字幕放映</h3>
                        <p data-i18n-cn="这张图拍自C329教室，使用系里的 Barco 投影机完成 DCP 放映测试，并制作日语竖排加 ruby 注音的外挂字幕，字幕以外挂形式展示，不烧入画面。" data-i18n-en="A DCP screening test on the department's Barco projector, paired with external Japanese vertical subtitles with ruby annotation rather than burned-in text.">这张图拍自C329教室，使用系里的 Barco 投影机完成 DCP 放映测试，并制作日语竖排加 ruby 注音的外挂字幕，字幕以外挂形式展示，不烧入画面。</p>
                    </div>
                </article>

                <article class="project-card project-card--summary" data-reveal>
                    <div class="card-image">
                        <img src={withBase("/media/portfolio/post-production/images/brand-post-cover.webp")} alt="Post-production and color grading work" loading="lazy" />
                    </div>
                    <div class="card-info">
                        <span class="category" data-i18n-cn="后期 / 剪辑 / 调色" data-i18n-en="Post / Editing / Color">后期 / 剪辑 / 调色</span>
                        <span class="card-status" data-i18n-cn="项目简述" data-i18n-en="Brief">项目简述</span>
                        <h3 data-i18n-cn="商业与品牌后期合作" data-i18n-en="Commercial and Brand Post-Production">商业与品牌后期合作</h3>
                        <p data-i18n-cn="参与短片剪辑、调色和影像包装，熟练使用 DaVinci Resolve。合作对象包括小红书、国家地理等品牌内容。" data-i18n-en="Editing, color grading, and visual packaging for short-form and commercial projects, with DaVinci Resolve as the core finishing tool.">参与短片剪辑、调色和影像包装，熟练使用 DaVinci Resolve。合作对象包括小红书、国家地理等品牌内容。</p>
                    </div>
                </article>
            </div>

        </section>

        <section class="work-section tools-section" aria-labelledby="tools-title">
            <div class="section-heading" data-reveal>
                <h2 id="tools-title" data-i18n-cn="实用小工具" data-i18n-en="Practical Tools">实用小工具</h2>
            </div>

            <div class="tool-grid">
                <article class="tool-card" data-reveal>
                    <div class="tool-preview" aria-hidden="true">
                        <div class="tool-preview__viewport">
                            <span></span>
                            <span></span>
                        </div>
                        <div class="tool-preview__baseline">
                            <i></i>
                            <strong>Camera Base</strong>
                            <i></i>
                        </div>
                    </div>
                    <div class="tool-info">
                        <h3>Stereoscopic 3D Camera Base Calculator</h3>
                        <a class="tool-button" href={stereoCalculatorUrl} target="_blank" rel="noreferrer" data-i18n-cn="打开网页" data-i18n-en="Open Tool">打开网页</a>
                    </div>
                </article>

                <article class="tool-card" data-reveal>
                    <div class="tool-preview anaglyph-preview" aria-hidden="true">
                        <div class="anaglyph-preview__frame">
                            <span class="anaglyph-preview__left"></span>
                            <span class="anaglyph-preview__right"></span>
                            <strong>Dubois</strong>
                        </div>
                    </div>
                    <div class="tool-info">
                        <h3>ZQ-Moonlight/dubois-anaglyph-converter</h3>
                        <a class="tool-button" href={duboisAnaglyphUrl} target="_blank" rel="noreferrer" data-i18n-cn="打开网页" data-i18n-en="Open Repository">打开网页</a>
                    </div>
                </article>
            </div>
        </section>

        <section class="work-section reel-hub" aria-labelledby="reel-hub-title">
            <div class="section-heading" data-reveal>
                <h2 id="reel-hub-title">Reel</h2>
            </div>

            <div class="reel-showcase">
                {reelItems.map((reel) => (
                    <article class="reel-card" data-reveal>
                        <div class="reel-card__player">
                            <ClickToPlayBilibili
                                bvid={reel.bvid}
                                page={reel.page}
                                title={reel.titleCn}
                                poster={reel.poster}
                                eyebrow={`Bilibili ${reel.duration}`}
                                heading={reel.titleCn}
                                description={reel.descriptionCn}
                            />
                        </div>
                        <div class="reel-card__body">
                            <span class="category" data-i18n-cn={reel.categoryCn} data-i18n-en={reel.categoryEn}>{reel.categoryCn}</span>
                            <h3 data-i18n-cn={reel.titleCn} data-i18n-en={reel.titleEn}>{reel.titleCn}</h3>
                            <p data-i18n-cn={reel.descriptionCn} data-i18n-en={reel.descriptionEn}>{reel.descriptionCn}</p>
                            <div class="reel-card__meta">
                                <span>{reel.duration}</span>
                                {reel.tags.map((tag) => <em>{tag}</em>)}
                            </div>
                            <a class="reel-card__link" href={`https://www.bilibili.com/video/${reel.bvid}/?p=${reel.page}`} target="_blank" rel="noreferrer">
                                在 Bilibili 打开
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        {shareDocs.length > 0 && (
            <section class="work-section reel-section" aria-labelledby="reel-title">
                <div class="section-heading" data-reveal>
                    <h2 id="reel-title" data-i18n-cn="分享资料" data-i18n-en="Shared Documents">分享资料</h2>
                </div>

                <div class="reel-list">
                    {shareDocs.map((item) => (
                        <a class="reel-item" href={item.href} target="_blank" rel="noreferrer" data-reveal>
                            <span class="file-chip">{item.kind}</span>
                            <span class="reel-item__main">
                                <strong data-i18n-cn={item.title} data-i18n-en={getShareDocCopy(item.title).titleEn}>{item.title}</strong>
                                {item.description && (
                                    <small data-i18n-cn={item.description} data-i18n-en={getShareDocCopy(item.title).descriptionEn ?? item.description}>{item.description}</small>
                                )}
                                <span class="reel-meta">
                                    <time>{item.uploadedLabel}</time>
                                    <span>{item.sizeLabel}</span>
                                </span>
                                <span class="reel-tags">
                                    {item.tags.map((tag) => <em>{tag}</em>)}
                                </span>
                            </span>
                        </a>
                    ))}
                </div>
            </section>
        )}
    </main>

    <footer class="site-footer" data-i18n-cn="© 2026 祝庆 Zhu Qing" data-i18n-en="© 2026 Zhu Qing">© 2026 祝庆 Zhu Qing</footer>
</BaseLayout>

<style>
    .portfolio-layout {
        max-width: 1420px;
    }

    .portfolio-hero {
        width: min(820px, 100%);
        margin-bottom: 72px;
    }

    .portfolio-hero h1 {
        margin: 12px 0 18px;
        color: var(--text-main);
        font-family: var(--font-display);
        font-size: var(--title-page);
        line-height: 1;
        letter-spacing: 0;
        text-wrap: balance;
    }

    .portfolio-hero p {
        margin: 0;
        color: var(--text-muted);
        font-size: var(--text-lead);
        line-height: 1.78;
    }

    .work-section {
        margin-bottom: 96px;
    }

    .reel-section {
        margin-top: 22px;
    }

    .work-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(28px, 4vw, 44px);
    }

    .project-card {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .tool-card {
        display: grid;
        gap: 20px;
        color: inherit;
        text-decoration: none;
    }

    .card-image {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        margin-bottom: 20px;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 6px;
