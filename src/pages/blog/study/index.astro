---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { withBase } from "../../../lib/paths";
import { studyTopics } from "../../../data/study-topics";
---

<BaseLayout title="学习资料 | 祝庆 Zhu Qing" description="关卡设计、动画特效与游戏研发的学习资料和案例笔记。" activePath="/blog" backgroundVariant="article">
    <main class="page-shell study-index">
        <a class="back-link" href={withBase("/blog/")}>← 返回档案</a>
        <header class="study-heading">
            <span class="eyebrow">游戏设计与研发</span>
            <h1>学习资料</h1>
            <p>按主题查阅游戏设计与研发的方法、案例和实践笔记。</p>
            <span class="collection-date">资料整理于 2026.10.26</span>
        </header>
        <div class="topic-grid">
            {studyTopics.map((topic) => (
                <a class="topic-card" href={withBase(`/blog/study/${topic.slug}/`)}>
                    <div class="topic-meta"><span>{topic.category}</span><span class:list={["access-label", { "is-locked": topic.protected }]}>{topic.protected ? "密码阅读" : "公开阅读"}</span></div>
                    <h2>{topic.title}</h2>
                    <p>{topic.description}</p>
                    <div class="topic-bottom"><span>{topic.detail}</span><span aria-hidden="true">↗</span></div>
                </a>
            ))}
        </div>
        <p class="access-note">标有“密码阅读”的专题在解锁后显示正文、图像与附件。</p>
    </main>
    <footer class="site-footer">© 2026 祝庆 Zhu Qing</footer>
</BaseLayout>

<style>
    .study-index { max-width: 1120px; }
    .back-link { display: inline-block; color: var(--text-muted); text-decoration: none; font-size: .85rem; margin-bottom: 40px; }
    .back-link:hover { color: var(--accent); }
    .study-heading { margin-bottom: 50px; }
    .study-heading h1 { font: 500 var(--title-page)/1.3 var(--font-display); margin: 12px 0 20px; }
    .study-heading p { color: var(--text-muted); font-size: var(--text-lead); line-height: 1.9; margin: 0 0 22px; }
    .collection-date { color: var(--text-dim); font-size: .78rem; }
    .topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .topic-card { display: flex; flex-direction: column; min-width: 0; padding: 28px 30px 24px; border: 1px solid var(--border); background: var(--bg-panel); border-radius: 8px; text-decoration: none; color: var(--text-main); transition: border-color 160ms, background 160ms; }
    .topic-card:hover { border-color: var(--accent); background: var(--bg-panel-strong); }
    .topic-meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; color: var(--text-dim); font-size: .76rem; }
    .access-label { color: var(--accent); }
    .access-label.is-locked { color: var(--text-muted); }
    .topic-card h2 { font: 500 clamp(1.25rem, 2vw, 1.55rem)/1.5 var(--font-display); margin: 26px 0 12px; }
    .topic-card p { color: var(--text-muted); font-size: .92rem; line-height: 1.9; margin: 0 0 28px; max-width: 34em; }
    .topic-bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 14px; padding-top: 18px; border-top: 1px solid var(--border); color: var(--text-dim); font-size: .75rem; }
    .topic-bottom span:last-child { font-size: 1.4rem; color: var(--accent); }
    .access-note { margin: 26px 0 0; color: var(--text-dim); font-size: .8rem; }
    @media (max-width: 700px) { .topic-grid { grid-template-columns: 1fr; } .topic-card { padding: 24px; } .study-heading { margin-bottom: 32px; } .back-link { margin-bottom: 28px; } }
</style>
